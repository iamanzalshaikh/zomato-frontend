# ─── Local dev (expo start / debug) ───
# Replace 192.168.1.101 with your PC LAN IP (ipconfig → IPv4)
# Android emulator: use 10.0.2.2 or your LAN IP
EXPO_PUBLIC_API_URL=http://192.168.1.101:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.101:5000

# ─── Production (Render) — already in .env.production for APK builds ───
# EXPO_PUBLIC_API_URL=https://zomato-backend-pt66.onrender.com/api/v1
# EXPO_PUBLIC_SOCKET_URL=https://zomato-backend-pt66.onrender.com

# Google Maps (optional)
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
