# CASE customer app — local API

# Point Expo at your CASE Postgres backend (clone-backend on port 5000).
# Replace LAN IP with your PC's IP when testing on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.100:5000

# Optional Android emulator host override
# EXPO_PUBLIC_ANDROID_API_HOST=10.0.2.2
